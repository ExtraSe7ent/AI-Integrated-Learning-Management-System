# Public HTTPS origin, no /mcp suffix. Loopback HTTP is only for local testing.
MCP_PUBLIC_URL=http://127.0.0.1:19090
MCP_PORT=19090
LMS_BACKEND_URL=http://127.0.0.1:8080
# Exact lecturer account IDs (not names), comma-separated. Required.
MCP_ALLOWED_USERS=*

# Same private service key as lms.mcp.internal-key in BE; at least 32 characters.
MCP_INTERNAL_KEY=
