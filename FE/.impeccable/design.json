  "narrative": {
    "northStar": "Campus agenda",
    "overview": "Giao diện Operate dành cho ngày học ở đại học: nhìn thấy lớp đang học, việc tiếp theo và trạng thái hoàn thành trước khi tìm thông tin bổ sung. Đỏ học thuật tạo điểm tựa, nền be ấm giữ không gian đọc bình tĩnh, các bề mặt trắng tách nội dung nghiệp vụ.\n\nBố cục có mật độ vừa phải, thanh điều hướng theo vai trò và ngữ cảnh học phần ổn định. Hai logo VJU được dùng nguyên hình trong khung phù hợp; không đổi màu hay kéo méo. Tên VJU Learning là nhãn làm việc của bản demo.",
    "keyCharacteristics": [
      "Thao tác chính rõ ràng, thông tin lớp và bài học luôn có ngữ cảnh.",
      "Đỏ định hướng hành động, trắng chứa công việc, be tạo nền đọc.",
      "Trạng thái có chữ; màu hỗ trợ nhận biết.",
      "Hành trình Trước lớp → Trong lớp → Sau lớp nối các màn học.",
      "Hai vai trò có nhận diện điều hướng riêng; thanh đầu mở điều hướng nhanh và thông báo tại chỗ."
    ],
    "rules": [
      {
        "name": "The Labeled State Rule",
        "body": "Mỗi trạng thái cần nhãn chữ; không dùng màu như tín hiệu duy nhất cho đúng/sai, chờ xử lý hoặc hoàn thành.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** giữ ngữ cảnh học phần và tên bài gần thao tác chính.",
      "**Do** dùng nhãn chữ cho trạng thái và nguồn phản hồi AI.",
      "**Do** giữ focus bàn phím rõ, form có label và hỗ trợ reduced motion.",
      "**Do** xếp lại nội dung trên mobile và cho bảng cuộn trong vùng riêng."
    ],
    "donts": [
      "**Don't** đổi màu, cắt mất nội dung hoặc kéo méo logo VJU.",
      "**Don't** trang trí bằng chuyển động hoặc bóng trên mọi panel.",
      "**Don't** dùng màu làm tín hiệu trạng thái duy nhất.",
      "**Don't** trình bày phản hồi mẫu, dữ liệu local hoặc thao tác demo như kết quả máy chủ thật."
    ]
  }
}
