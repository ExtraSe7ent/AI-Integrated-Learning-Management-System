# Biến môi trường. Spring Boot không tự đọc file này: đặt vào môi trường trước khi chạy.

# Bắt buộc với profile prod
LMS_JWT_SECRET=
LMS_AES_PASSPHRASE=
LMS_AES_SALT=

# PostgreSQL (profile prod)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=edumanager_db
DB_USER=edumanager
DB_PASSWORD=edumanager_pass

# Mật khẩu cấp cho tài khoản import hoặc reset; người dùng phải đổi khi đăng nhập
LMS_DEFAULT_PASSWORD=12345678
LMS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AI (OpenAI-compatible). Để trống thì dùng trợ lý theo luật.
OPENROUTER_API_KEY=
VILAO_API_KEY=
CHAT_PROVIDER=openrouter
CHAT_MODEL=google/gemini-2.5-flash
FAST_PROVIDER=vilao
FAST_MODEL=gemini-3.8-flash
EMBED_PROVIDER=vilao
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
AI_DAILY_LIMIT_STUDENT=40
AI_DAILY_LIMIT_TEACHER=200
